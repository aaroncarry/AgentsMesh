load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "factory",
    srcs = ["register.go"],
    importpath = "github.com/anthropics/agentsmesh/runner/internal/agents/factory",
    visibility = ["//runner:__subpackages__"],
    deps = [
        "//runner/internal/acp",
        "//runner/internal/agentkit",
    ],
)

alias(
    name = "go_default_library",
    actual = ":factory",
    visibility = ["//runner:__subpackages__"],
)

go_test(
    name = "factory_test",
    srcs = ["register_test.go"],
    embed = [":factory"],
    deps = ["//runner/internal/acp"],
)
