load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "factory",
    srcs = [
        "parser.go",
        "register.go",
    ],
    importpath = "github.com/anthropics/agentsmesh/runner/internal/agents/factory",
    visibility = ["//runner:__subpackages__"],
    deps = [
        "//runner/internal/acp",
        "//runner/internal/agentkit",
        "//runner/internal/logger",
        "//runner/internal/tokenusage",
    ],
)

alias(
    name = "go_default_library",
    actual = ":factory",
    visibility = ["//runner:__subpackages__"],
)

go_test(
    name = "factory_test",
    srcs = [
        "parser_test.go",
        "register_test.go",
    ],
    embed = [":factory"],
    deps = [
        "//runner/internal/acp",
        "//runner/internal/tokenusage",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
